[Unit]
Description=NAS blackbox collector
After=docker.service local-fs.target nas_jetson_nano-blackbox-boot.service
Wants=docker.service nas_jetson_nano-blackbox-boot.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/nas-layout.env
ExecStart=/usr/bin/python3 "${NAS_PROJECT_DIR}/scripts/monitoring/nas_jetson_nano-blackbox.py"
Restart=on-failure
RestartSec=10
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/mnt/storage/blackbox /var/lib/nas-blackbox
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0027
MemoryLimit=64M
CPUQuota=10%
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
