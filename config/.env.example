# ==========================================================
# Home Cloud Jetson public template
# Copy this file to .env and replace values locally.
# Never commit real .env to GitHub.
# ==========================================================

# General
TZ=Europe/Berlin
PUID=1000
PGID=1000

# Network
JETSON_LAN_IP=192.168.0.50
NEXTCLOUD_HOST=cloud.local
IMMICH_HOST=photos.local
LLM_GATEWAY_HOST=llm.local

# Optional Keenetic Omni KN-1410 extender inventory.
# Real label values belong only in local config/.env and must never be committed.
KEENETIC_OMNI_MODEL=KN-1410
KEENETIC_OMNI_ADMIN_URL=http://my.keenetic.net
KEENETIC_OMNI_LAN_IP=
KEENETIC_OMNI_FACTORY_SSID=change_me_local_only
KEENETIC_OMNI_FACTORY_WIFI_PASSWORD=change_me_local_only
KEENETIC_OMNI_SERVICE_CODE=change_me_local_only
KEENETIC_OMNI_SERIAL=change_me_local_only
KEENETIC_OMNI_WAN_MAC=change_me_local_only
KEENETIC_OMNI_ADMIN_PASSWORD=change_me_local_only

# Jetson access (Stage 0 — USB device mode over Micro-USB)
# Jetson всегда поднимает себя на 192.168.55.1, хост получает 192.168.55.100.
JETSON_SSH_USER=admin
JETSON_HOSTNAME=nas_jetson_nano-jetson
JETSON_DEVICE_MODE_IP=192.168.55.1
JETSON_DEVICE_MODE_HOST_IP=192.168.55.100
# Реальный пароль задавать только в локальном config/.env (НЕ коммитить).
JETSON_SSH_PASSWORD=CHANGE-ME

# Storage
STORAGE_ROOT=/mnt/storage
NEXTCLOUD_DATA=/mnt/storage/nextcloud/data
IMMICH_UPLOAD_LOCATION=/mnt/storage/immich/library
IMMICH_DB_DATA_LOCATION=/mnt/storage/db/immich-postgres
NEXTCLOUD_DB_DATA=/mnt/storage/db/nextcloud-postgres
BACKUP_ROOT=/mnt/storage/backups
# USB HDD block device for SMART monitoring (scripts/diagnostics/storage_health.sh §6)
# Run: lsblk -o NAME,SIZE,FSTYPE,MODEL to find your device
# Example: /dev/sda (full disk) or /dev/sda1 (partition)
STORAGE_DEVICE=/dev/sda
# Optional smartctl device type for USB bridges: sat, scsi, etc.
STORAGE_SMART_DEVICE_TYPE=

# Nextcloud
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me
NEXTCLOUD_TRUSTED_DOMAINS="192.168.0.50 cloud.local"
NEXTCLOUD_DB_NAME=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=change_me

# Immich
IMMICH_VERSION=release
IMMICH_DB_NAME=immich
IMMICH_DB_USER=immich
IMMICH_DB_PASSWORD=change_me
IMMICH_DISABLE_MACHINE_LEARNING=true

# Redis
REDIS_PASSWORD=change_me

# LLM Gateway / DeepSeek
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# Budget — ENFORCED by the gateway (fail-closed, 429 when exceeded).
LLM_DAILY_TOKEN_LIMIT=100000
LLM_MONTHLY_COST_LIMIT_USD=10
# Price used for the monthly cost estimate; configurable because it changes.
LLM_PRICE_USD_PER_MTOKEN=0.5
# Where the usage counters are persisted (mount a volume to survive restarts).
LLM_USAGE_FILE=/data/llm_usage.json
LLM_LOG_PROMPTS=false
LLM_LOG_RESPONSES=false
LLM_REDACT_PERSONAL_DATA=true
LLM_ALLOW_FILE_CONTENT_UPLOAD=false
LLM_ALLOW_IMAGE_ANALYSIS=false

# Names stripped before anything leaves the house.
# ⚠️ This is a WORD LIST, not a named-entity model. Declensions are handled
# automatically (Ольга → Ольге/Ольгой), but DIMINUTIVES ARE NOT — they are a
# different stem. Verified by test: "Ольга" in this list does NOT catch "Оля".
# List every form your family actually uses, full names AND diminutives:
LLM_REDACT_NAMES=Ольга Оля Ульяна Уля Иван Ваня Анна Аня Алексей Лёша Леша

# Optional future provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o

# Backup
RESTIC_REPOSITORY=/mnt/storage/backups/restic-repo
RESTIC_PASSWORD=change_me
# Альтернатива: путь к файлу с паролем (приоритетнее, чем RESTIC_PASSWORD).
# RESTIC_PASSWORD_FILE=/root/.restic-password
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12

# Backup API (services/backup-api/, Stage 2 — Android-клиент восстановления)
# Сервис намеренно отключён в Stage 1 (не разворачивать на боевом Jetson до Stage 2).
BACKUP_API_PORT=8095
# Bearer-токен для авторизации Android-клиента (длинная случайная строка,
# например: openssl rand -hex 32).
BACKUP_API_TOKEN=change_me_long_random_token
# Корневая папка для пользовательских бэкапов с устройств.
BACKUP_API_STORAGE_ROOT=/mnt/storage/backups/devices
# Stage-флаг: 1 — реальный режим, 0 — mock (по умолчанию для Stage 1).
BACKUP_API_ENABLED=0

# ---------------------------------------------------------------------------
# VPS (external relay server) — docs/plans/VPS_INTEGRATION_PLAN.md
# ---------------------------------------------------------------------------
VPS_HOST=your.vps.ip.here
VPS_USER=root
VPS_SSH_KEY=~/.ssh/id_ed25519
# restic offsite: RESTIC_REPOSITORY=sftp:root@${VPS_HOST}:/opt/nas_jetson_nano/backups/restic-repo

# ---------------------------------------------------------------------------
# DDNS — DuckDNS (scripts/network/ddns_duckdns.sh, systemd/nas_jetson_nano-ddns-update.timer)
# Зарегистрировать на https://www.duckdns.org — бесплатно, без карты.
# ---------------------------------------------------------------------------
DUCKDNS_DOMAIN=nas_jetson_nano-home          # поддомен без .duckdns.org
DUCKDNS_TOKEN=change_me           # токен с duckdns.org/account

# ---------------------------------------------------------------------------
# NAS_Jetson_Nano API — JWT auth (services/nas_jetson_nano-api/)
# ---------------------------------------------------------------------------
# Секрет JWT: openssl rand -hex 32
NAS_JETSON_NANO_API_JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
NAS_JETSON_NANO_API_JWT_TTL_HOURS=24
# URL Nextcloud внутри Docker-сети (для проверки credentials)
NEXTCLOUD_INTERNAL_URL=http://host.docker.internal:8080

# ---------------------------------------------------------------------------
# Talk AI bot — Phase A (polling). Отвечает в семейном чате на команды
# ping / статус / диск / фото. Отвечает из локальных данных, в облако не ходит.
# ---------------------------------------------------------------------------
# Включить бота (по умолчанию выключен — код можно деплоить безопасно).
TALK_BOT_ENABLED=false
# Комната для прослушивания; пусто → TALK_FAMILY_ROOM (37pcobmf).
TALK_BOT_ROOM=
# Необязательный префикс команд, напр. "нас" → "нас статус". Пусто = без префикса.
TALK_BOT_TRIGGER=
# Имя, под которым бот пишет ответы.
TALK_BOT_DISPLAY_NAME=NAS Bot
# Таймаут серверного long-poll, сек.
TALK_BOT_POLL_TIMEOUT=30

# Phase C — free-form questions routed to the provider through the gateway.
# The privacy boundary is the word you type: TALK_BOT_TRIGGER stays home,
# this callsign deliberately goes out. Empty = feature off.
TALK_BOT_LLM_TRIGGER=@бобик
TALK_BOT_LLM_DISPLAY_NAME=Бобик
TALK_BOT_LLM_URL=http://host.docker.internal:8090/v1/chat
TALK_BOT_LLM_TIMEOUT=60
TALK_BOT_LLM_MAX_CHARS=1000
TALK_BOT_LLM_DAILY_REPLIES=50

# ---------------------------------------------------------------------------
# Samba NAS (docker/compose/docker-compose.samba.yml)
# ---------------------------------------------------------------------------
# Пароль для SMB-пользователя "nas" (crazymax/samba secrets)
# Генерация: openssl rand -base64 20
SAMBA_NAS_PASSWORD=change_me
