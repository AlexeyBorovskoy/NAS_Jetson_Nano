# DP-1/DEP-2: the ML image is pinned by tag and sha256 digest directly in the
# Compose file. Do not add an image override here; upgrades are reviewed edits.
IMMICH_ML_PORT=3003
# 🔴 Только 127.0.0.1 — аудит CF-4. Наружу видно исключительно через обратный
# SSH-туннель (scripts/workstation/immich_ml_station.ps1), не через LAN-бинд.
IMMICH_ML_HOST_BIND=127.0.0.1
TZ=Europe/Moscow
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_WORKER_TIMEOUT=300
