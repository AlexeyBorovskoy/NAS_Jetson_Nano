[Unit]
Description=NAS blackbox boot snapshot
After=local-fs.target docker.service mnt-storage.mount
Wants=mnt-storage.mount
Before=nas_jetson_nano-boot-alert.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/nas-layout.env
ExecStart=/usr/bin/python3 "${NAS_PROJECT_DIR}/scripts/monitoring/nas_jetson_nano-blackbox-boot.py"
TimeoutStartSec=300
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/mnt/storage/blackbox /var/lib/nas-blackbox
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
MemoryLimit=128M
Nice=10

[Install]
WantedBy=multi-user.target
