[Unit]
Description=NAS_Jetson_Nano off-site backup pull (Wave 0, phase 1: DB dumps only)
Documentation=https://github.com/AlexeyBorovskoy/NAS_Jetson_Nano
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/nas-offsite-backup.sh
IOSchedulingClass=idle
CPUSchedulingPolicy=idle
Nice=19
MemoryMax=512M
