# Закреплено на версию сервера Jetson (D6/DEP-2, 2026-09-26). Проверить перед
# запуском: ssh admin@192.168.0.50 "docker inspect homecloud_immich_server --format '{{.Config.Image}}'"
# ML-воркер и сервер обязаны совпадать по версии Immich — не менять на "release".
IMMICH_VERSION=v2.7.5
# IMMICH_ML_IMAGE не задавать здесь — оставить дефолт compose-файла
# (…machine-learning:${IMMICH_VERSION}-cuda), иначе он снова обгонит IMMICH_VERSION.
# CPU fallback, если CUDA не поднимается:
# IMMICH_ML_IMAGE=ghcr.io/immich-app/immich-machine-learning:v2.7.5
IMMICH_ML_PORT=3003
# 🔴 Только 127.0.0.1 — аудит CF-4. Наружу видно исключительно через обратный
# SSH-туннель (scripts/workstation/immich_ml_station.ps1), не через LAN-бинд.
IMMICH_ML_HOST_BIND=127.0.0.1
TZ=Europe/Moscow
MACHINE_LEARNING_WORKERS=1
MACHINE_LEARNING_WORKER_TIMEOUT=300
