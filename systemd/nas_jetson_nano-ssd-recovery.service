[Unit]
Description=NAS_Jetson_Nano SSD Hotplug Auto-Recovery
Documentation=https://github.com/AlexeyBorovskoy/NAS_Jetson_Nano
# Run outside normal boot dependency tree — triggered by udev at any time
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/home/admin/nas_jetson_nano/scripts/storage/ssd_hotplug_recovery.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nas_jetson_nano-ssd-recovery
# Allow up to 120s for mount + preflight + Docker start
TimeoutStartSec=120
