# =============================================================================
# Sber-era cutover snippet — merge into device config/.env (NOT a full .env)
# ADR-0008 / DEVELOPMENT_PLAN_2026-09_SBER_ERA.md
# Secrets: fill AUTH_KEY / CLOUDRU / DEEPSEEK on device only — never commit real values.
# =============================================================================

# ── Family default LLM ───────────────────────────────────────────────────────
LLM_PROVIDER=gigachat
LLM_PREFER_LOCAL=false
LLM_GIGA_FALLBACK_DEEPSEEK=true

# ── GigaChat PERS ────────────────────────────────────────────────────────────
# GIGACHAT_AUTH_KEY=   # base64(client_id:client_secret) — keep existing if set
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_IMAGE_MODEL=GigaChat-2-Max
GIGACHAT_CA_BUNDLE=/certs/russian_trusted_bundle.pem
GIGACHAT_VERIFY_SSL=true

# ── Talk @бобик ──────────────────────────────────────────────────────────────
TALK_BOT_LLM_PROVIDER=gigachat
TALK_BOT_LLM_TIMEOUT=150

# ── DeepSeek fallback (must stay valid) ──────────────────────────────────────
# DEEPSEEK_API_KEY=    # keep existing
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── Cloud.ru Foundation Models (optional until key issued) ───────────────────
# Static API key for service "Foundation Models" (Bearer) — not IAM Key Secret alone.
# CLOUDRU_FM_API_KEY=
CLOUDRU_FM_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_FM_MODEL=GigaChat/GigaChat-2-Max
CLOUDRU_FM_MAX_TOKENS=2048
CLOUDRU_FM_TIMEOUT=120

# ── Local Ollama (prod off) ──────────────────────────────────────────────────
LLM_LOCAL_URL=
LLM_PREFER_LOCAL=false
